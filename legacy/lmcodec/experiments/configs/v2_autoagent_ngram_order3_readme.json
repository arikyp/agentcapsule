{
  "experiment_name": "v2-autoagent-ngram-order3-readme",
  "payload_path": "README.md",
  "model": {
    "type": "ngram",
    "training": {
      "corpus_path": "examples/carrier_train_v2.txt",
      "order": 3,
      "alpha": 1.0,
      "uniform_mix": 0.75
    }
  },
  "shape_settings": {
    "uniform_mix": 0.0,
    "temperature": 1.0,
    "min_probability": 0.0,
    "min_entropy_bits": 0.0
  },
  "max_steps": 500000,
  "run_golden_tests": true,
  "wrap": 80,
  "quality_text_path": "examples/carrier_heldout_v2.txt",
  "promotion_gate": {
    "min_entropy_bits": 5.4
  },
  "output_dir": "experiments/runs/v2_autoagent_ngram_order3_readme"
}
