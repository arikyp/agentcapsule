{
  "matrix_name": "v2-large-payload-realish",
  "output_dir": "experiments/runs/v2_large_payload_realish_matrix",
  "wrap": 80,
  "max_steps": 900000,
  "run_golden_tests": false,
  "payloads": [
    {
      "name": "binary_1kb",
      "kind": "range",
      "start": 0,
      "count": 1024
    },
    {
      "name": "binary_10kb",
      "kind": "range",
      "start": 17,
      "count": 10240
    },
    {
      "name": "binary_100kb",
      "kind": "range",
      "start": 31,
      "count": 102400
    },
    {
      "name": "text_1kb",
      "kind": "text_repeat",
      "bytes": 1024,
      "token": "lmcodec v2 stress text payload with repeated report lines\n"
    },
    {
      "name": "text_10kb",
      "kind": "text_repeat",
      "bytes": 10240,
      "token": "the checkpoint records entropy, runtime, and roundtrip status\n"
    },
    {
      "name": "text_100kb",
      "kind": "text_repeat",
      "bytes": 102400,
      "token": "large deterministic text payload for lmcodec carrier stress testing\n"
    }
  ],
  "corpora": [
    {
      "name": "project_docs",
      "kind": "files",
      "domain": "project_docs",
      "paths": [
        "README.md",
        "CHANGELOG.md",
        "docs/ALGORITHM.md",
        "docs/CARRIER_QUALITY.md",
        "docs/V2_CHECKPOINT.md"
      ],
      "heldout_ratio": 0.2,
      "split_seed": 101,
      "max_chars": 120000
    },
    {
      "name": "v2_reports",
      "kind": "files",
      "domain": "v2_reports",
      "paths": [
        "docs/V2_BASELINE.md",
        "docs/V2_SPRINT_1.md",
        "docs/V2_SPRINT_2.md",
        "docs/V2_SPRINT_3.md",
        "docs/V2_CANDIDATE_ORDER3.md",
        "docs/V2_CANDIDATE_ORDER3_SHAPED.md",
        "docs/V2_CANDIDATE_ORDER2_SAFETY.md",
        "docs/V2_CANDIDATE_TRANSFORMER_FIXTURE.md"
      ],
      "heldout_ratio": 0.2,
      "split_seed": 202,
      "max_chars": 120000
    }
  ],
  "candidates": [
    {
      "name": "order3_quality",
      "model": {
        "type": "ngram",
        "training": {
          "order": 3,
          "alpha": 1.0,
          "uniform_mix": 0.75
        }
      },
      "shape_settings": {
        "uniform_mix": 0.0,
        "temperature": 1.0,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.4
      }
    },
    {
      "name": "order3_balanced_shape",
      "model": {
        "type": "ngram",
        "training": {
          "order": 3,
          "alpha": 1.0,
          "uniform_mix": 0.75
        }
      },
      "shape_settings": {
        "uniform_mix": 0.1,
        "temperature": 1.15,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.6
      }
    },
    {
      "name": "order2_safety_mix",
      "model": {
        "type": "ngram",
        "training": {
          "order": 2,
          "alpha": 1.0,
          "uniform_mix": 0.85
        }
      },
      "shape_settings": {
        "uniform_mix": 0.0,
        "temperature": 1.0,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.6
      }
    }
  ]
}
