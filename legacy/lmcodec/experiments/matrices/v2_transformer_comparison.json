{
  "matrix_name": "v2-transformer-comparison",
  "output_dir": "experiments/runs/v2_transformer_comparison_matrix",
  "wrap": 80,
  "max_steps": 2500000,
  "run_golden_tests": false,
  "payloads": [
    {
      "name": "binary_1kb",
      "kind": "range",
      "start": 19,
      "count": 1024
    },
    {
      "name": "binary_10kb",
      "kind": "range",
      "start": 37,
      "count": 10240
    },
    {
      "name": "binary_100kb",
      "kind": "range",
      "start": 73,
      "count": 102400
    },
    {
      "name": "text_1kb",
      "kind": "text_repeat",
      "bytes": 1024,
      "token": "transformer comparison payload line for lmcodec v2\n"
    },
    {
      "name": "text_10kb",
      "kind": "text_repeat",
      "bytes": 10240,
      "token": "comparing transformer fixture against ngram baselines with deterministic text\n"
    },
    {
      "name": "text_100kb",
      "kind": "text_repeat",
      "bytes": 102400,
      "token": "larger transformer comparison payload for bounded lmcodec baseline testing\n"
    }
  ],
  "corpora": [
    {
      "name": "all_repo_text",
      "kind": "files",
      "domain": "all_repo_text",
      "paths": [
        "README.md",
        "CHANGELOG.md",
        "pyproject.toml",
        "docs/ALGORITHM.md",
        "docs/BENCHMARKING.md",
        "docs/CARRIER_QUALITY.md",
        "docs/EXPERIMENTS.md",
        "docs/LIMITATIONS.md",
        "docs/V2_CHECKPOINT.md",
        "docs/V2_LARGE_PAYLOAD_STRESS_RESULTS.md",
        "docs/V2_REAL_CORPUS_PAYLOAD_LADDER_RESULTS.md",
        "docs/V2_1MB_REAL_CORPUS_CEILING_RESULTS.md",
        "src/lmcodec/codec.py",
        "src/lmcodec/range_coder.py",
        "src/lmcodec/probability.py",
        "src/lmcodec/quantizer.py",
        "src/lmcodec/lm.py",
        "src/lmcodec/transformer.py",
        "scripts/run_experiment.py",
        "scripts/run_matrix.py"
      ],
      "heldout_ratio": 0.2,
      "split_seed": 707,
      "max_chars": 200000
    },
    {
      "name": "all_tests_protocol",
      "kind": "files",
      "domain": "all_tests_protocol",
      "paths": [
        "docs/TESTING.md",
        "docs/V1_RELEASE.md",
        "docs/V2_EXPERIMENT_PROTOCOL.md",
        "docs/V2_MERGE_STRATEGY.md",
        "tests/test_codec.py",
        "tests/test_golden.py",
        "tests/test_lm.py",
        "tests/test_probability.py",
        "tests/test_property_roundtrip.py",
        "tests/test_quantizer.py",
        "tests/test_range_coder.py",
        "tests/test_range_coder_stress.py",
        "tests/test_run_experiment.py",
        "tests/test_run_matrix.py"
      ],
      "heldout_ratio": 0.2,
      "split_seed": 808,
      "max_chars": 200000
    }
  ],
  "candidates": [
    {
      "name": "order3_quality",
      "model": {
        "type": "ngram",
        "training": {
          "order": 3,
          "alpha": 1.0,
          "uniform_mix": 0.75
        }
      },
      "shape_settings": {
        "uniform_mix": 0.0,
        "temperature": 1.0,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.4
      }
    },
    {
      "name": "order3_balanced_shape",
      "model": {
        "type": "ngram",
        "training": {
          "order": 3,
          "alpha": 1.0,
          "uniform_mix": 0.75
        }
      },
      "shape_settings": {
        "uniform_mix": 0.1,
        "temperature": 1.15,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.6
      }
    },
    {
      "name": "order2_safety_mix",
      "model": {
        "type": "ngram",
        "training": {
          "order": 2,
          "alpha": 1.0,
          "uniform_mix": 0.85
        }
      },
      "shape_settings": {
        "uniform_mix": 0.0,
        "temperature": 1.0,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.6
      }
    },
    {
      "name": "transformer_fixture",
      "model": {
        "type": "transformer",
        "path": "tests/fixtures/transformer_model_v1.json"
      },
      "shape_settings": {
        "uniform_mix": 0.8,
        "temperature": 1.25,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.8
      }
    }
  ]
}
