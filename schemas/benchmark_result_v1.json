{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arikyp/lmcodec/schemas/benchmark_result_v1.json",
  "title": "LMCodec benchmark result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp_utc",
    "git_commit",
    "payload",
    "settings",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timestamp_utc": {
      "type": "string",
      "description": "UTC timestamp in ISO-8601 form. Runtime-varying."
    },
    "git_commit": {
      "type": ["string", "null"],
      "description": "Git commit SHA when available."
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "base64_baseline_chars"],
      "properties": {
        "path": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base64_baseline_chars": {"type": "integer", "minimum": 0}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "topk", "shape"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "topk": {"type": "integer", "minimum": 0},
        "shape": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uniform_mix",
            "temperature",
            "min_probability",
            "min_entropy_bits"
          ],
          "properties": {
            "uniform_mix": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "temperature": {"type": "number", "exclusiveMinimum": 0.0},
            "min_probability": {"type": "number", "minimum": 0.0},
            "min_entropy_bits": {"type": "number", "minimum": 0.0}
          }
        }
      }
    },
    "carrier_quality": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "unique_character_count",
        "character_frequency",
        "longest_repeated_run",
        "char_frequency_l1_divergence",
        "char_frequency_kl_bits",
        "preview_sample"
      ],
      "properties": {
        "unique_character_count": {"type": "integer", "minimum": 0},
        "character_frequency": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "longest_repeated_run": {"type": "integer", "minimum": 0},
        "char_frequency_l1_divergence": {"type": ["number", "null"], "minimum": 0.0},
        "char_frequency_kl_bits": {"type": ["number", "null"], "minimum": 0.0},
        "preview_sample": {"type": "string"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "payload_path",
        "payload_bytes",
        "payload_sha256",
        "model_type",
        "model_fingerprint",
        "model_path",
        "settings",
        "carrier_chars",
        "full_armour_chars",
        "bits_per_carrier_char",
        "base64_baseline_chars",
        "encode_seconds",
        "decode_seconds",
        "roundtrip_success",
        "heldout_nll_bits",
        "heldout_tokens",
        "avg_entropy_bits",
        "avg_top_probability",
        "carrier_quality",
        "convergence_failure_count",
        "error_message"
      ],
      "properties": {
        "name": {"type": "string"},
        "payload_path": {"type": "string"},
        "payload_bytes": {"type": "integer", "minimum": 0},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_type": {"type": "string"},
        "model_fingerprint": {"type": ["string", "null"]},
        "model_path": {"type": ["string", "null"]},
        "settings": {"$ref": "#/$defs/settings"},
        "carrier_chars": {"type": ["integer", "null"], "minimum": 0},
        "full_armour_chars": {"type": ["integer", "null"], "minimum": 0},
        "bits_per_carrier_char": {"type": ["number", "null"], "minimum": 0.0},
        "base64_baseline_chars": {"type": "integer", "minimum": 0},
        "encode_seconds": {"type": ["number", "null"], "minimum": 0.0},
        "decode_seconds": {"type": ["number", "null"], "minimum": 0.0},
        "roundtrip_success": {"type": "boolean"},
        "heldout_nll_bits": {"type": ["number", "null"], "minimum": 0.0},
        "heldout_tokens": {"type": ["integer", "null"], "minimum": 0},
        "avg_entropy_bits": {"type": ["number", "null"], "minimum": 0.0},
        "avg_top_probability": {"type": ["number", "null"], "minimum": 0.0},
        "carrier_quality": {"$ref": "#/$defs/carrier_quality"},
        "convergence_failure_count": {"type": "integer", "minimum": 0},
        "error_message": {"type": ["string", "null"]},
        "score": {"type": "number"},
        "carrier_diversity": {"type": "number", "minimum": 0.0}
      }
    }
  }
}
