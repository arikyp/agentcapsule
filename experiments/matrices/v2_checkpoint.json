{
  "matrix_name": "v2-checkpoint",
  "output_dir": "experiments/runs/v2_checkpoint_matrix",
  "wrap": 80,
  "max_steps": 120000,
  "run_golden_tests": false,
  "payloads": [
    {
      "name": "empty",
      "kind": "empty"
    },
    {
      "name": "tiny_text",
      "kind": "text",
      "text": "lmcodec v2 checkpoint payload\n"
    },
    {
      "name": "structured_json",
      "kind": "text",
      "text": "{\"codec\":\"lmcodec\",\"version\":\"v2-checkpoint\",\"cases\":[\"roundtrip\",\"entropy\",\"quality\"],\"ok\":true}\n"
    },
    {
      "name": "binary_256",
      "kind": "range",
      "start": 0,
      "count": 256
    }
  ],
  "corpora": [
    {
      "name": "codec",
      "domain": "codec",
      "lines": 240,
      "seed": 42,
      "heldout_ratio": 0.2
    },
    {
      "name": "notes",
      "domain": "notes",
      "lines": 240,
      "seed": 43,
      "heldout_ratio": 0.2
    },
    {
      "name": "mixed",
      "domain": "mixed",
      "lines": 240,
      "seed": 44,
      "heldout_ratio": 0.2
    }
  ],
  "candidates": [
    {
      "name": "order3_quality",
      "model": {
        "type": "ngram",
        "training": {
          "order": 3,
          "alpha": 1.0,
          "uniform_mix": 0.75
        }
      },
      "shape_settings": {
        "uniform_mix": 0.0,
        "temperature": 1.0,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.4
      }
    },
    {
      "name": "order3_balanced_shape",
      "model": {
        "type": "ngram",
        "training": {
          "order": 3,
          "alpha": 1.0,
          "uniform_mix": 0.75
        }
      },
      "shape_settings": {
        "uniform_mix": 0.1,
        "temperature": 1.15,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.6
      }
    },
    {
      "name": "order2_safety_mix",
      "model": {
        "type": "ngram",
        "training": {
          "order": 2,
          "alpha": 1.0,
          "uniform_mix": 0.85
        }
      },
      "shape_settings": {
        "uniform_mix": 0.0,
        "temperature": 1.0,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.6
      }
    },
    {
      "name": "transformer_fixture",
      "model": {
        "type": "transformer",
        "path": "tests/fixtures/transformer_model_v1.json"
      },
      "shape_settings": {
        "uniform_mix": 0.8,
        "temperature": 1.25,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.8
      }
    }
  ]
}
