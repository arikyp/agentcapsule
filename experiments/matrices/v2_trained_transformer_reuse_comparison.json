{
  "matrix_name": "v2-trained-transformer-reuse-comparison",
  "output_dir": "experiments/runs/v2_trained_transformer_reuse_comparison_matrix",
  "wrap": 80,
  "max_steps": 500000,
  "run_golden_tests": false,
  "payloads": [
    {
      "name": "binary_1kb",
      "kind": "range",
      "start": 29,
      "count": 1024
    },
    {
      "name": "binary_10kb",
      "kind": "range",
      "start": 61,
      "count": 10240
    },
    {
      "name": "text_1kb",
      "kind": "text_repeat",
      "bytes": 1024,
      "token": "trained transformer comparison payload for lmcodec v2\n"
    },
    {
      "name": "text_10kb",
      "kind": "text_repeat",
      "bytes": 10240,
      "token": "bounded trained transformer reuse comparison against ngram baselines\n"
    }
  ],
  "corpora": [
    {
      "name": "repo_code_docs",
      "kind": "files",
      "domain": "repo_code_docs",
      "paths": [
        "README.md",
        "CHANGELOG.md",
        "pyproject.toml",
        "docs/ALGORITHM.md",
        "docs/CARRIER_QUALITY.md",
        "docs/V2_CHECKPOINT.md",
        "docs/V2_TRANSFORMER_COMPARISON_RESULTS.md",
        "src/lmcodec/codec.py",
        "src/lmcodec/range_coder.py",
        "src/lmcodec/lm.py",
        "src/lmcodec/transformer.py",
        "scripts/run_matrix.py"
      ],
      "heldout_ratio": 0.2,
      "split_seed": 909,
      "max_chars": 120000
    },
    {
      "name": "tests_protocol",
      "kind": "files",
      "domain": "tests_protocol",
      "paths": [
        "docs/TESTING.md",
        "docs/V1_RELEASE.md",
        "docs/V2_EXPERIMENT_PROTOCOL.md",
        "tests/test_codec.py",
        "tests/test_golden.py",
        "tests/test_lm.py",
        "tests/test_probability.py",
        "tests/test_range_coder.py",
        "tests/test_run_matrix.py"
      ],
      "heldout_ratio": 0.2,
      "split_seed": 1001,
      "max_chars": 120000
    }
  ],
  "candidates": [
    {
      "name": "order3_quality",
      "model": {
        "type": "ngram",
        "training": {
          "order": 3,
          "alpha": 1.0,
          "uniform_mix": 0.75
        }
      },
      "shape_settings": {
        "uniform_mix": 0.0,
        "temperature": 1.0,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.4
      }
    },
    {
      "name": "order3_balanced_shape",
      "model": {
        "type": "ngram",
        "training": {
          "order": 3,
          "alpha": 1.0,
          "uniform_mix": 0.75
        }
      },
      "shape_settings": {
        "uniform_mix": 0.1,
        "temperature": 1.15,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.6
      }
    },
    {
      "name": "transformer_fixture",
      "model": {
        "type": "transformer",
        "path": "tests/fixtures/transformer_model_v1.json"
      },
      "shape_settings": {
        "uniform_mix": 0.8,
        "temperature": 1.25,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.8
      }
    },
    {
      "name": "transformer_trained_tiny",
      "reuse_model_per_corpus": true,
      "model": {
        "type": "transformer",
        "training": {
          "block_size": 8,
          "d_model": 8,
          "ff_dim": 12,
          "seed": 42,
          "epochs": 1,
          "learning_rate": 0.05,
          "smoothing": 0.25
        }
      },
      "shape_settings": {
        "uniform_mix": 0.5,
        "temperature": 1.15,
        "min_probability": 0.0,
        "min_entropy_bits": 0.0
      },
      "promotion_gate": {
        "min_entropy_bits": 5.4
      }
    }
  ]
}
